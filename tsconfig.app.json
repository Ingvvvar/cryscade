{
  // Браузерный код под Vite. server/ исключён: у него свой конфиг без DOM.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // Сетка фикстуры в срезе фазы 3 — JSON из fixtures/rounds/ (временное ребро ui → fixtures, §3).
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/server/**/*"]
}
