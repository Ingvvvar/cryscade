{
  // Инструменты и конфиги запускает Node: разрешение модулей как у Node.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2024",
    "lib": ["ES2024"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true
  },
  "include": ["tools/**/*", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "eslint.config.js"]
}
